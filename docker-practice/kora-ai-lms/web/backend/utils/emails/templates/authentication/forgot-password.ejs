<div class="main-container">
  <%- include('../partials/header.ejs') %>

    <div class="template-banner">
      <div class="text-field">
        <h1>Reset Your Password</h1>
      </div>
    </div>

    <div class="template-container">
      <div class="inner-container">
        <p class="text-center message bold black">Hello, <%= emailUsername %>
        </p>

        <p class="text-center message bold black font-30">
          Someone requested that the password be reset for the following account:
        </p>

        <p class="text-center message normal black">
          To reset you password, visit the following address:
        </p>

        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 30px 0">
          <tr>
            <td align="center">
              <a href="<%= storeUrl %>/reset-password/<%= token %>" style="
                display: inline-block;
                background-color: #6F2CCA;
                color: #ffffff !important;
                text-decoration: none !important;
                font-size: 18px;
                font-weight: 600;
                padding: 16px 40px;
                border-radius: 6px;
                font-family: &quot;Outfit&quot;, Arial, sans-serif;
                letter-spacing: 0.3px;
              ">
                Click Here To Reset Your Password
              </a>
            </td>
          </tr>
        </table>

        <p class="text-center message bold black">
          This link will expire in 10 minutes.
        </p>

        <p class="text-center message normal black">
          If you didn't request a password reset, you can safely ignore this
          email.
        </p>

        <p class="template-thankyou-message black">— The Rubitt Team</p>
      </div>
    </div>

    <%- include('../partials/footer.ejs') %>
</div>