<div class="main-container">
  <%- include('../partials/header.ejs') %>

    <div class="template-banner">
      <div class="text-field">
        <h1>Verify your OTP Code</h1>
      </div>
    </div>
    <div class="template-container" style="padding: 0 !important">
      <div class="inner-container">
        <h2 class="message normal black text-center">Welcome to Rubitt 👋</h2>
        <h2 class="message bold black text-center">Hi <%= name %>,</h2>
        <p class="message normal black text-center">
          Thanks for signing up for Rubitt! To finish creating your account, please
          use the verification code below:
        </p>
        <h2 class="message bold black text-center">Your verification code:</h2>
        <div class="otp-box">
          <%= otp %>
        </div>
        <p class="message normal black text-center">
          Enter this code in the app to verify your email address and continue
          setting up your account.
        </p>
        <p class="message normal black text-center">
          <img
            src="data:image/svg+xml;base64,"
            alt="clock icon" width="26" height="26" style="
            vertical-align: middle;
            display: inline-block;
            margin-right: 4px;
          " />
          This code will expire in a 10 minutes for security purposes.
        </p>
        <p class="message normal black text-center">
          If you didn’t request this code, you can safely ignore this email.
        </p>
        <p class="message normal black text-center">
          We’re excited to help you organize your classes and turn lectures into
          powerful study tools.
        </p>
        <p class="template-thankyou-message black">— The Rubitt Team</p>
      </div>
    </div>

    <%- include('../partials/footer.ejs') %>
</div>