<div class="main-container">
  <%- include('../partials/header.ejs') %>


    <div class="template-banner">
      <div class="text-field">
        <h1>Password Changed Successfully</h1>
      </div>
    </div>

    <div class="template-container">
      <div class="inner-container">
        <p class="message bold black">Dear <strong class="capitalize">
            <%= userName %>
          </strong>,</p>
        <p class="message normal black">This is a confirmation that your password was changed on <strong>
            <%= changedAt %>
          </strong>.</p>
        <p class="message normal black">If you did not perform this action, please contact our support team immediately.
        </p>
        <p class="message normal black">Stay secure,</p>
        <p class="template-thankyou-message black">— The Rubitt Team</p>

      </div>
    </div>

    <%- include('../partials/footer.ejs') %>
</div>