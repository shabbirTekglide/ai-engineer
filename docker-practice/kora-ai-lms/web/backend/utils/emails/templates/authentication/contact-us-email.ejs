<div class="main-container">
    <%- include('../partials/header.ejs') %>

    <div class="template-banner">
        <div class="text-field">
            <h1>New Contact Message</h1>
        </div>
    </div>

    <div class="template-container">
        <div class="inner-container">
            <h2 class="message bold black text-center">
                You have a new message from <%= firstName %> <%= lastName %>
            </h2>

            <p class="message normal black text-center">
                A user has submitted the contact form with the following details:
            </p>

            <!-- Contact details in a clean card-like layout -->
            <div style="background: #f9fafb; border-radius: 12px; padding: 24px; margin: 24px 0;">
                <p class="message normal black" style="margin-bottom: 12px;">
                    <strong style="color: #2c3e50; min-width: 80px; display: inline-block;">Name:</strong>
                    <%= firstName %> <%= lastName %>
                </p>
                <p class="message normal black" style="margin-bottom: 12px;">
                    <strong style="color: #2c3e50; min-width: 80px; display: inline-block;">Email:</strong>
                    <a href="mailto:<%= email %>" style="color: #4a6cf7; text-decoration: none;"><%= email %></a>
                </p>
                <p class="message normal black" style="margin-bottom: 0;">
                    <strong style="color: #2c3e50; min-width: 80px; display: inline-block;">Message:</strong>
                </p>
                <div style="background: white; border-radius: 8px; padding: 16px; margin-top: 8px; border-left: 4px solid #4a6cf7; white-space: pre-line; font-style: italic; color: #2c3e50;">
                    <%= message %>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
</div>