<div class="main-container">
    <%- include('../partials/header.ejs') %>
        <div class="template-banner">
            <div class="text-field">
                <h1>Password Changed</h1>
            </div>
        </div>

        <div class="template-container">
            <div class="inner-container">
                <p class="message bold black">Dear <strong class="capitalize">
                        <%= userName %>
                    </strong>,</p>
                <p class="message normal black">This is to confirm that the password for your account with an email
                    <strong>
                        <%= userEmail %>
                    </strong> & <strong>
                        <%= role %>
                    </strong> has been successfully changed at <strong>
                        <%= changedAt %>
                    </strong>.</p>
                <p class="message normal black">If you did not request this change, please contact our support team
                    immediately.</p>
                <p class="message normal black">Stay secure,</p>
                <p class="template-thankyou-message black"><strong>— The Rubitt Team</strong></p>
            </div>
        </div>

        <%- include('../partials/footer.ejs') %>
</div>