<%- include('./partials/header.ejs') %>
    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="container">
            <div class="container-inner">
                <div class="faq-header">
                    <h2 class="faq-title fs-32 fw-700">Frequently Asked Questions</h2>
                </div>

                <div class="faq-list">
                    <!-- FAQ Item 1 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>Can I use Rubitt for all of my classes?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Yes! Rubitt is designed to work with any class or subject. Whether
                                    you're studying sciences, humanities, business, or any other field, Rubitt's
                                    AI-powered tools can help you process lecture content, generate notes, create study
                                    materials, and stay organized across all your courses.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 2 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>Do I have to use my phone, or can I use Rubitt on my laptop?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Rubitt is available on both web and mobile platforms. You can use it on
                                    your laptop through our web application or on your smartphone with our native mobile
                                    app. All your data syncs seamlessly across devices, so you can record lectures on
                                    your phone and review notes on your laptop.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 3 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>Are my lecture recordings private and secure?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Absolutely. Your privacy is our top priority. Lecture recordings are
                                    processed immediately and then deleted from our servers. Your study materials belong
                                    to you, and we never use your content to train AI models. All data is encrypted and
                                    protected with modern security infrastructure.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 4 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>What happens if I cancel my subscription? Do I lose my notes?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Your notes and study materials remain accessible even after canceling
                                    your subscription. You'll have read-only access to all previously generated content.
                                    However, you won't be able to record new lectures or generate new AI-powered
                                    materials until you reactivate your subscription.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 5 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>Does Rubitt work with online classes, YouTube lectures, or uploaded audio?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Yes! Rubitt works with live in-person lectures, online classes, and
                                    pre-recorded content. You can record audio directly through the app during live
                                    classes, or upload existing audio files from YouTube lectures, recorded sessions, or
                                    any other audio source to generate notes and study materials.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 6 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>What's included in the free trial?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">The free trial gives you 7 days of full access to all Rubitt features,
                                    including one free lecture recording with transcription, AI-powered note generation,
                                    study guides, flashcards, practice quizzes, and calendar sync. It's a great way to
                                    experience everything Rubitt has to offer before committing to a paid plan.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 7 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>How many hours of transcription do I get?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Rubitt Basic includes up to 20 hours of lecture recording and
                                    transcription per month, which is typically enough for 10-15 classes. Rubitt Pro
                                    offers unlimited recordings and transcriptions, perfect for students with heavy
                                    course loads or those who want to record every lecture without worrying about
                                    limits.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 8 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>Will Rubitt replace my regular notes?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Rubitt is designed to complement your study routine, not replace it.
                                    While our AI generates comprehensive notes from lectures, many students find it
                                    helpful to review and add their own annotations. Rubitt handles the heavy lifting of
                                    transcription and organization, so you can focus on understanding and personalizing
                                    your study materials.</p>
                            </div>
                        </div>
                    </div>

                    <!-- FAQ Item 9 -->
                    <div class="faq-item">
                        <button class="faq-question fs-16 fw-500">
                            <span>How is Rubitt different from ChatGPT, Notion, or Quizlet?</span>
                            <svg class="faq-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <div class="faq-answer">
                            <div class="faq-answer-content">
                                <p class="fs-16">Unlike general-purpose tools, Rubitt is specifically built for
                                    students.
                                    It combines lecture recording, transcription, AI-powered note generation,
                                    flashcards, quizzes, and calendar management in one platform. Instead of juggling
                                    multiple apps, you get an all-in-one solution designed around your academic
                                    workflow, with features like syllabus sync that other tools don't offer.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Still Have Questions -->
                <div class="faq-contact">
                    <h3 class="faq-contact-title fs-24 fw-700">Still Have Questions?</h3>
                    <p class="faq-contact-text fs-18">Can't find the answer you're looking for? No problem. Our team is
                        here to help. Send us a message and we'll get back to you.</p>
                    <button class="btn btn-primary btn-md fs-14 fw-500">Contact Us</button>
                </div>
            </div>
        </div>
    </section>
    <%- include('./partials/footer.ejs') %>