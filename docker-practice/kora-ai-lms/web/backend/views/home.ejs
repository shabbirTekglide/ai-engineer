<%- include('./partials/header.ejs') %>

    <section class="hero-section">
        <div class="container">
            <div class="hero-card">
                <h1 class="hero-title">Welcome to Rubitt</h1>

                <div class="hero-subtitle">
                    <span class="typing-wrapper">
                        <span id="typing-text"></span>
                        <span class="cursor">|</span>
                    </span>
                    <!-- SEO-safe fallback -->
                    <span class="seo-text">
                        Simplify your studies. Organize your tasks. Ace your exams.
                    </span>
                </div>
                <p class="hero-description">
                    Rubitt transforms your lectures into notes, flashcards, quizzes, and study guides, while
                    keeping your classes, tasks, and study plan organized.
                </p>
                <div class="hero-buttons">
                    <button class="btn btn-primary btn-md free-trial-btn"><span> Start Your Free Trial</span><svg
                            style="width: 1rem; height: 1rem;" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                        </svg></button>
                    <a class="btn btn-secondary learn-more-btn" href="#learn-more" class="btn btn-secondary"><span>Learn
                            more</span><span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Demo section  -->
    <section class="demo-section">
        <div class="container">
            <div class="container-inner">
                <div class="demo-content">
                    <span class="demo-badge">See it in action</span>
                    <h2 class="demo-title fs-32 fw-700">Watch a quick demo</h2>
                    <p class="demo-description fs-16 fw-500">
                        See how Rubitt can transform your study workflow in just a few clicks.
                    </p>

                    <div class="video-wrapper" id="videoWrapper">
                        <video id="demoVideo" class="video-player" poster="" preload="metadata" playsinline>
                            <source src="/videos/kora.webm" type="video/webm">
                            <source src="/videos/kora.mp4" type="video/mp4">
                            Your browser does not support the video tag.
                        </video>

                        <div class="video-overlay" id="videoOverlay">
                            <div class="play-button" id="playButton">
                                <div class="play-icon"></div>
                            </div>
                        </div>

                        <!-- Custom Video Controls (appear on hover when playing) -->
                        <div class="custom-controls" id="customControls">
                            <div class="controls-overlay">
                                <button class="control-btn" id="playPauseBtn">
                                    <svg class="pause-icon" width="24" height="24" viewBox="0 0 24 24" fill="white">
                                        <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
                                    </svg>
                                </button>
                                <div class="progress-container">
                                    <input type="range" class="progress-bar" id="progressBar" min="0" max="100"
                                        value="0">

                                </div>
                                <button class="control-btn" id="volumeBtn">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                                        <path
                                            d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" />
                                    </svg>
                                </button>
                                <button class="control-btn" id="fullscreenBtn">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                                        <path
                                            d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section" id="learn-more">
        <div class="container">
            <div class="container-inner">
                <div class="features-header">
                    <span class="features-badge">Study Smarter</span>
                    <h2 class="features-title fs-32 fw-700">Everything you need to excel</h2>
                    <p class="features-description">
                        Rubitt is packed with features designed to automate the tedious parts of studying, so you can
                        focus on
                        understanding.
                    </p>
                </div>

                <div class="features-grid">
                    <!-- Feature 1 -->
                    <div class="feature-card">
                        <div class="feature-content">
                            <div class="feature-main">
                                <div class="feature-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
