                                        <path d="m8 17 4-4 4 4"></path>
                                    </svg>
                                </div>
                                <h3 class="feature-title fs-24 fw-700">Syllabus Sync</h3>
                            </div>

                            <p class="feature-text">Upload your syllabus and Rubitt will automatically populate your
                                calendar with due dates and send you reminders.</p>
                        </div>
                        <div class="feature-image">
                            <img src="/images/home/syllabus-sync.webp" alt="Syllabus Sync">
                        </div>
                    </div>

                    <!-- Feature 5 -->
                    <div class="feature-card">
                        <div class="feature-content">
                            <div class="feature-main">
                                <div class="feature-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round"
