        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-card">
                <div class="container-inner">


                    <h2 class="cta-title fs-32 fw-700">Start Studying Smarter Today</h2>
                    <p class="cta-description fs-18">
                        Get transcripts, notes, flashcards, quizzes, an AI tutor, syllabus sync, and a built-in study
