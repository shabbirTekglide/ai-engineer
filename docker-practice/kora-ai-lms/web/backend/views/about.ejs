<%- include('./partials/header.ejs') %>

    <!-- pricing main Section -->
    <section class="about-us-section">
        <div class="container about-us-container">
            <div class="container-inner">
                <div class="content">
                    <h2 class="cta-title fs-48 fw-700 pt-sans-bold ">
                        Our Mission
                    </h2>
                    <p class="cta-description fs-20">
                        To revolutionize the way students learn by transforming traditional lectures into dynamic,
                        personalized study materials. We empower every student to achieve their full academic potential.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Page - Our Story Section -->
    <section class="about-page story-section">
        <div class="container">
            <div class="container-inner">
                <div class="story-grid">
                    <!-- Story Content -->
                    <div class="story-content">
                        <h2 class="story-title fs-32 fw-700">Our Story</h2>
                        <div class="story-text">
                            <p class="fs-18">
                                Rubitt was born from a simple realization: the lecture, a cornerstone of education for
                                centuries, hasn't kept up with the pace of technology. Students spend countless hours
                                passively listening, scribbling notes, and then manually creating study aids. We knew
                                there had to be a better way.
                            </p>
                            <p class="fs-18">
                                We envisioned a world where every lecture becomes an opportunity, not a chore. A world
                                where AI could handle the heavy lifting—transcribing, summarizing, and organizing—so
                                students could focus on what truly matters: understanding and mastering the material.
                                That vision is Rubitt.
                            </p>
                        </div>
                    </div>

                    <!-- Story Image -->
                    <div class="story-image">
                        <img src="/images/about/about-story.webp" alt="Students studying together with Rubitt">
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- our values  -->
    <section class="trust-section">
        <div class="container">
            <div class="container-inner">
                <div class="trust-header">
                    <h2 class="trust-title fs-32 fw-700">Our Values</h2>
                    <p class="trust-description fs-18">
                        These are the principles that guide our team, our product, and our mission to support students
                        everywhere.
                    </p>
                </div>

                <div class="trust-grid">
                    <!-- Trust Card 1 -->
